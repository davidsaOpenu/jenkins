# Instructor setup file — copy to students.yaml, fill in, then run:
#   ./setup_students.sh
# (it asks for the Jenkins URL and admin login — they are not kept here)
#
# Keep students.yaml private — it contains passwords and is gitignored.
# Re-running setup_students.sh is safe — existing users/nodes are updated
# (each password is reset to the value below).

students:
  - name: ""          # short id, no spaces — node: <name>-vm, Jenkins user: <name>
    project: ""       # free-text label, for the instructor's own reference only
    password: ""      # Jenkins UI password for this student

  - name: ""
    project: ""
    password: ""
