# Central Jenkins config — used only by deploy_central_jenkins.sh.
#
# Fill this in and run: sudo ./central_deploy/deploy_central_jenkins.sh central_deploy/gerrit_central.yml
# NEVER commit this file once real values are filled in.

# ---------------------------------------------------------------------------
# REQUIRED — the only things the Gerrit Trigger plugin needs to listen to
# GerritHub events and trigger jobs.
# ---------------------------------------------------------------------------

# GerritHub username Jenkins connects as (use a dedicated service account,
# not a personal one). Also the Jenkins admin login.
gerrit_username: ""

# Filename under /root/.ssh, on the machine that runs
# deploy_central_jenkins.sh, of the private key registered to that
# GerritHub account. The key itself must already be there — this only
# names it. It is copied into Jenkins for the Gerrit Trigger plugin.
# Generate with: sudo ssh-keygen -t ed25519 -f /root/.ssh/gerrit_jenkins_key -C "jenkins@swiftacular"
# Register /root/.ssh/gerrit_jenkins_key.pub at: https://review.gerrithub.io/settings/#SSHKeys
ssh_key_name: ""

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Jenkins login password for gerrit_username. Leave blank to have one
# generated (once — re-runs reuse it) into /etc/jenkins-dr/admin_password.
jenkins_admin_password: ""

# The full address users and agents reach Jenkins at:
#   https://<host>             HTTPS on 443 (default)
#   http://<host>/jenkins      plain HTTP on 80, under a path
# Scheme picks the port, the path (if any) becomes Jenkins' URL prefix.
# No port number — nginx always serves 80 (http) or 443 (https).
# Leave blank for https://<IP auto-detected from the default route> — only
# safe on a machine with a single network interface. Plain http sends
# logins and agent secrets unencrypted; prefer https.
jenkins_url: ""

# For https only. The certificate and its private key, as files already on
# this machine — nginx serves Jenkins with them on 443. Set both, or leave
# both blank: a self-signed pair is then created for jenkins_url's host at
# /etc/jenkins-dr/tls/ (browsers warn; give students jenkins-dr.crt as
# their central_ca_cert).
tls_cert_file: ""
tls_key_file: ""

# ---------------------------------------------------------------------------
# OPTIONAL — end-to-end push test. Set all three, or none.
# Without them the deploy checks that the Gerrit Trigger plugin is
# connected to GerritHub. With them it also pushes a real patchset onto
# change_id and waits for the jenkins-dr-test job to build it (CI's
# run.sh always sets them).
# ---------------------------------------------------------------------------

# Email registered to gerrit_username's GerritHub account — Gerrit rejects
# commits whose committer email isn't registered.
email: ""

# Git commit author name for the test patchset.
display_name: ""

# A fixed Change-Id (Ixxxx...) on a permanent Gerrit change on
# davidsaOpenu/swiftacular, reserved for test pushes — each push lands as a
# new patchset on that same change instead of opening a new one.
change_id: ""
