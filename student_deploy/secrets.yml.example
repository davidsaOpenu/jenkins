# Copy this file to secrets.yml, fill in your values, then run:
#   sudo ./deploy_agent.sh secrets.yml

# Your GerritHub username — used for the Check-owner gating stage in your
# project's Jenkinsfile (only builds patchsets you authored).
gerrit_owner_username: ""

# Central Jenkins connection — provided by the instructor after they run
# central_deploy/setup_students.sh for you.
central_url: ""
central_agent_name: ""    # e.g. alice-vm
central_agent_secret: ""  # from the instructor
