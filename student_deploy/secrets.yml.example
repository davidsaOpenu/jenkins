# Normally your instructor sends you a ready-made secrets.yml — use that
# instead. Only without one: copy this file to secrets.yml, fill in your
# values, then run:
#   sudo ./deploy_agent.sh secrets.yml

# Your GerritHub username. Your builds are routed to this agent by its
# label (set by the instructor), not by this value — it is only exported
# to the agent as GERRIT_OWNER_USERNAME.
gerrit_owner_username: ""

# Central Jenkins connection — provided by the instructor after they run
# central_deploy/setup_students.sh for you.
central_url: ""
central_agent_name: ""    # e.g. alice-vm
central_agent_secret: ""  # from the instructor

# Only if the instructor gave you a certificate file (central uses a
# self-signed certificate): its path on this machine. Otherwise leave blank.
# (A secrets.yml from the instructor carries it inline instead, as
# central_ca_cert_pem.)
central_ca_cert: ""
