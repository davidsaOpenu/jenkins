# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.provider :libvirt do |libvirt|
    libvirt.qemu_use_session = false
  end

  config.vm.define "jenkins-node" do |sv|
    sv.vm.box      = "eurolinux-vagrant/centos-stream-9"
    sv.vm.hostname = "jenkins-node"
    sv.vm.network "forwarded_port", guest: 8080, host: 8080

    sv.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus   = 1
    end

    sv.vm.provision "ansible" do |ansible|
      ansible.playbook          = "deploy_jenkins.yaml"
      ansible.host_key_checking = false
    end
  end
end
