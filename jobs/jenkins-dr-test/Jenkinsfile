pipeline {
    agent any

    triggers {
        gerrit(
            customUrl: '',
            gerritProjects: [[
                branches: [[
                    compareType: 'PLAIN',
                    pattern: "${params.GERRIT_BRANCH ?: 'master'}"
                ]],
                compareType: 'PLAIN',
                disableStrictForbiddenFileVerification: true,
                pattern: 'davidsaOpenu/swiftacular',
                filePaths: [[
                    compareType: 'ANT',
                    pattern: 'dr_test/**'
                ]]
            ]],
            serverName: 'review.gerrithub.io',
            triggerOnEvents: [
                patchsetCreated(
                    excludeDrafts: true,
                    excludeTrivialRebase: true,
                    excludeNoCodeChange: true,
                    excludeWip: true
                ),
                changeMerged(),
                changeRestored()
            ]
        )
    }

    parameters {
        string(name: 'GERRIT_REFSPEC', defaultValue: 'refs/heads/master')
        string(name: 'GERRIT_BRANCH',  defaultValue: 'master')
    }

    stages {
        stage('DR Test') {
            steps {
                echo "Triggered by a dr_test/** patchset on swiftacular."
            }
        }
    }
}
