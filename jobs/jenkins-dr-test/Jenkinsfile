// Routes to whichever agent belongs to the patchset's uploader — which
// node builds this IS the routing decision (assertOwnNode() below only
// double-checks it). Same derivation as jenkins.yaml.j2's built-in-node
// label and setup_students.sh.
def agentLabel(String username) {
    if (!username) {
        error('No Gerrit uploader on this build — refusing to pick a node.')
    }
    return username.replaceAll(/[^A-Za-z0-9]+/, '-')
}

// Defense in depth behind the label routing: the first thing inside the
// node block, before any step touches the node — stops the build unless
// the node really is the uploader's own: their "<name>-vm"
// (setup_students.sh), or the built-in node for central's own identity.
// GERRIT_OWNER_USERNAME is only trusted on the built-in node, where the
// controller alone sets it (JCasC's globalNodeProperties) — on an agent
// it comes from that agent's own service unit. NODE_NAME is blank (or
// "master") on the built-in node on some Jenkins versions; normalized.
def assertOwnNode(String username) {
    def node = env.NODE_NAME
    if (!node || node == 'master') {
        node = 'built-in'
    }
    def own = (node == 'built-in') ? (username == env.GERRIT_OWNER_USERNAME)
                                   : (node == username + '-vm')
    if (!own) {
        error("Refusing to run: landed on '${node}', which is not ${username}'s own node.")
    }
    return node
}

pipeline {
    agent none

    triggers {
        gerrit(
            customUrl: '',
            skipVote: [
                onSuccessful: true,
                onFailed: true,
                onUnstable: true,
                onNotBuilt: true
            ],
            gerritProjects: [[
                branches: [[
                    compareType: 'PLAIN',
                    // ?: 'master' — on the very first build params.GERRIT_BRANCH
                    // is null; without the fallback the trigger re-registers
                    // with branch pattern "null" and never matches again.
                    pattern: "${params.GERRIT_BRANCH ?: 'master'}"
                ]],
                compareType: 'PLAIN',
                disableStrictForbiddenFileVerification: true,
                pattern: 'davidsaOpenu/swiftacular',
                filePaths: [[
                    compareType: 'ANT',
                    pattern: 'dr_test/**'
                ]]
            ]],
            serverName: 'review.gerrithub.io',
            triggerOnEvents: [
                patchsetCreated(
                    excludeDrafts: true,
                    excludeTrivialRebase: true,
                    excludeNoCodeChange: true,
                    excludeWip: true
                ),
                changeMerged(),
                changeRestored(),
                commentAddedContains(
                    '(?i)^(Patch Set [0-9]+:)?( [\\w\\\\+-]*)*' +
                    '(\\n\\n)?\\s*(recheck)'
                )
            ]
        )
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '24'))
        // Timestamps every console line — makes the pause/resume gap around
        // the Approval stage's input step visibly obvious in the log.
        timestamps()
    }

    parameters {
        string(name: 'GERRIT_REFSPEC', defaultValue: 'refs/heads/master')
        string(name: 'GERRIT_BRANCH',  defaultValue: 'master')
    }

    stages {
        stage('Approval') {
            steps {
                // No node is allocated here (agent none above) — nothing
                // touches anyone's node until the uploader approves.
                // submitter: limits who may click, but an admin always
                // passes it — the loop below is the real check, using the
                // real authenticated clicker's identity.
                script {
                    def uploader = env.GERRIT_PATCHSET_UPLOADER_USERNAME
                    if (!uploader) {
                        error('Manual builds are not supported — this job only runs from a real Gerrit push or a "recheck" comment.')
                    }
                    // Exactly what the click lets run, so it's an informed
                    // one — the prompt sits right below this in the console.
                    echo """PAUSED — waiting for ${uploader} to approve this build.
  Event:     ${env.GERRIT_EVENT_TYPE}
  Project:   ${env.GERRIT_PROJECT} (branch ${env.GERRIT_BRANCH})
  Change:    ${env.GERRIT_CHANGE_NUMBER} — ${env.GERRIT_CHANGE_SUBJECT}
             ${env.GERRIT_CHANGE_URL}
  Patch set: ${env.GERRIT_PATCHSET_NUMBER}, uploaded by ${uploader}
  Commit:    ${env.GERRIT_PATCHSET_REVISION}
  Runs on:   ${uploader}'s own node, nobody else's"""
                    def approver = null
                    def matched = false
                    for (int attempt = 1; attempt <= 2 && !matched; attempt++) {
                        timeout(time: 15, unit: 'MINUTES') {
                            approver = input message: "${uploader}: run change ${env.GERRIT_CHANGE_NUMBER} patch set ${env.GERRIT_PATCHSET_NUMBER} " +
                                                      "(commit ${env.GERRIT_PATCHSET_REVISION}) on your own node? " +
                                                      "Only approve code you have reviewed — it runs with your agent's privileges. (attempt ${attempt}/2)",
                                             ok: 'Run it on my node',
                                             submitter: uploader,
                                             submitterParameter: 'APPROVER'
                        }
                        matched = (approver == uploader)
                        if (!matched) {
                            echo "REJECTED (attempt ${attempt}/2) — ${approver} is not ${uploader}."
                        }
                    }
                    if (!matched) {
                        error("Approval failed — wrong identity after 2 attempts")
                    }
                    echo "APPROVED by ${approver} — resuming build."
                }
            }
        }
        stage('Dummy') {
            agent { label agentLabel(env.GERRIT_PATCHSET_UPLOADER_USERNAME) }
            steps {
                // Checks the node is the uploader's own, then records it as
                // structured build metadata (read via api/json), not
                // console text.
                script {
                    currentBuild.description = assertOwnNode(env.GERRIT_PATCHSET_UPLOADER_USERNAME)
                }
                sh 'ls'
            }
        }
    }
}
