// Approval gate, own-node routing and superseding older patch sets
// (approvalGate, abortOlderPatchsets, buildLabel, assertOwnNode): the
// osw-ci library, vars/ in this repo.
@Library('osw-ci') _

properties([
    [$class: 'PriorityJobProperty', priority: 20]
])

pipeline {
    agent none

    triggers {
        gerrit(
            customUrl: '',
            gerritProjects: [[
                branches: [[
                    compareType: 'PLAIN',
                    pattern: "${params.GERRIT_BRANCH}"
                ]],
                compareType: 'PLAIN',
                disableStrictForbiddenFileVerification: false,
                pattern: 'davidsaOpenu/xv6'
            ]],
            serverName: 'review.gerrithub.io',
            triggerOnEvents: [
                patchsetCreated(
                    excludeDrafts: true,
                    excludeTrivialRebase: true,
                    excludeNoCodeChange: true,
                    excludeWip: true
                ),
                changeMerged(),
                changeRestored(),
                commentAddedContains(
                    '(?i)^(Patch Set [0-9]+:)?( [\\w\\\\+-]*)*' +
                    '(\\n\\n)?\\s*(recheck)'
                )
            ]
        )
        cron('@daily')
    }

    options {
        buildDiscarder(
            logRotator(
                daysToKeepStr: '14',
                numToKeepStr: '24'
            )
        )
        timestamps()
    }

    parameters {
        string(
            name: 'GERRIT_REFSPEC',
            defaultValue: 'refs/heads/master',
            description: ''
        )
        string(
            name: 'GERRIT_BRANCH',
            defaultValue: 'master',
            description: ''
        )
    }

    stages {
        stage('Approval') {
            steps {
                // agent none above: no node is held while it waits.
                // Central's own builds (timer, admin) pass straight
                // through to the built-in node.
                script {
                    approvalGate(allowCentralBuilds: true)
                    abortOlderPatchsets()
                }
            }
        }
        stage('Build') {
            agent { label buildLabel() }
            // The build's own limit — the Approval wait above is not
            // counted against it.
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            stages {
                stage('Own node') {
                    steps {
                        script {
                            currentBuild.description = assertOwnNode()
                        }
                    }
                }
                stage('Checkout') {
                    steps {
                        script {
                            sh "ls; rm -rf *; ls"

                            def repos = [
                                [
                                    dir: 'xv6',
                                    branch: params.GERRIT_BRANCH,
                                    url: 'https://review.gerrithub.io/davidsaOpenu/xv6',
                                    useSubmodules: true
                                ],

                            ]

                            for (repo in repos) {
                                if (repo.dir == 'xv6') {
                                    checkout(scmGit(
                                        branches: [[name: repo.branch]],
                                        extensions: [
                                            [$class: 'RelativeTargetDirectory', relativeTargetDir: repo.dir],
                                            [$class: 'BuildChooserSetting', buildChooser: [$class: 'GerritTriggerBuildChooser']],
                                            [$class: 'SubmoduleOption', recursiveSubmodules: true],
                                            [$class: 'CloneOption', timeout: 20],
                                        ],
                                        userRemoteConfigs: [
                                            [refspec: params.GERRIT_REFSPEC,
                                             url: repo.url]
                                        ]
                                    ))
                                }
                            }
                        }
                    }
                }

                stage('Setup VM and Test Podman') {
                    steps {
                        script {
                            sh '''
                                ./xv6/infra/bootstrap.sh
                            '''
                        }
                    }
                }
            }
        }
    }
}
