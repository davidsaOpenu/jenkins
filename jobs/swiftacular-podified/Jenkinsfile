// Approval gate, own-node routing and superseding older patch sets
// (approvalGate, abortOlderPatchsets, buildLabel, assertOwnNode): the
// osw-ci library, vars/ in this repo.
@Library('osw-ci') _

properties([
    [$class: 'PriorityJobProperty', priority: 3]
])

pipeline {
    agent none

    triggers {
        gerrit(
            customUrl: '',
            gerritProjects: [[
                branches: [[
                    compareType: 'PLAIN',
                    pattern: "${params.GERRIT_BRANCH}"
                ]],
                compareType: 'PLAIN',
                disableStrictForbiddenFileVerification: false,
                pattern: 'davidsaOpenu/swiftacular',
                filePaths: [[
                    compareType: 'ANT',
                    pattern: 'kube_deploy/**'
                ]]
            ]],
            serverName: 'review.gerrithub.io',
            triggerOnEvents: [
                patchsetCreated(
                    excludeDrafts: true,
                    excludeTrivialRebase: true,
                    excludeNoCodeChange: true,
                    excludeWip: true
                ),
                changeMerged(),
                changeRestored(),
                commentAddedContains(
                    '(?i)^(Patch Set [0-9]+:)?( [\\w\\\\+-]*)*' +
                    '(\\n\\n)?\\s*(recheck)'
                )
            ]
        )
        cron('@daily')
    }

    options {
        buildDiscarder(
            logRotator(
                daysToKeepStr: '14',
                numToKeepStr: '24'
            )
        )
        timestamps()
    }

    parameters {
        string(
            name: 'GERRIT_REFSPEC',
            defaultValue: 'refs/heads/master',
            description: ''
        )
        string(
            name: 'GERRIT_BRANCH',
            defaultValue: 'master',
            description: ''
        )
    }

    stages {
        stage('Approval') {
            steps {
                // agent none above: no node or lock is held while it
                // waits. Central's own builds (timer, admin) pass
                // straight through to the built-in node.
                script {
                    approvalGate(allowCentralBuilds: true)
                    abortOlderPatchsets()
                }
            }
        }
        stage('Acquire lock') {
            agent { label buildLabel() }
            steps {
                script {
                    currentBuild.description = assertOwnNode()
                    if (env.GERRIT_CHANGE_ID) {
                        // Gerrit builds: Change-ID specific lock (one executor per node already serializes the node)
                        lock(resource: "gerrit-${env.GERRIT_CHANGE_ID}", inversePrecedence: true) {
                            echo "Acquired lock: change=${env.GERRIT_CHANGE_ID}"
                            timeout(time: 220, unit: 'MINUTES') {
                                runPipeline()
                            }
                        }
                    } else {
                        // Non-Gerrit builds: no lock
                        timeout(time: 220, unit: 'MINUTES') {
                            runPipeline()
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        // Only on the build's own node: nothing runs on a
                        // node the build was refused on.
                        if (env.OWN_NODE_OK == 'yes') {
                            dir('swiftacular') {
                                sh './kube_deploy/scripts/teardown-cluster.sh'
                            }
                        }
                    }
                }
            }
        }
    }
}

def protectedStage(String name, Closure body) {
    stage(name) {
        if (currentBuild.result == 'ABORTED') {
            echo "Skipping stage '${name}' — build was aborted"
            return
        }
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            body()
        }
    }
}

def runPipeline() {
    protectedStage('Checkout') {
        def repos = [
            [
                dir: 'swiftacular',
                branch: params.GERRIT_BRANCH,
                url: 'https://review.gerrithub.io/davidsaOpenu/swiftacular',
                useSubmodules: true
            ],
        ]

        sh "ls; rm -rf *; ls"
        for (repo in repos) {
            if (repo.dir == 'swiftacular') {
                checkout(scmGit(
                    branches: [[name: repo.branch]],
                    extensions: [
                        [$class: 'RelativeTargetDirectory', relativeTargetDir: repo.dir],
                        [$class: 'BuildChooserSetting', buildChooser: [$class: 'GerritTriggerBuildChooser']],
                        [$class: 'SubmoduleOption', recursiveSubmodules: true],
                        [$class: 'CloneOption', timeout: 20],
                    ],
                    userRemoteConfigs: [
                        [refspec: params.GERRIT_REFSPEC,
                         url: repo.url]
                    ]
                ))
            } else {
                checkout(scmGit(
                    branches: [[name: repo.branch]],
                    extensions: [
                        [$class: 'RelativeTargetDirectory', relativeTargetDir: repo.dir],
                        [$class: 'CloneOption', timeout: 20],
                        [$class: 'SubmoduleOption', recursiveSubmodules: false],
                    ],
                    userRemoteConfigs: [
                        [url: repo.url]
                    ]
                ))
            }
        }
    }

    protectedStage('Pre-build cleanup') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/teardown-cluster.sh'
        }
    }

    protectedStage('Bootstrap Cluster') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/bootstrap-cluster.sh'
        }
    }

    protectedStage('Build Images') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/build-images.sh'
        }
    }

    protectedStage('Deploy') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/deploy.sh --skip-bootstrap --skip-build --skip-smoke'
        }
    }

    protectedStage('Smoke Test') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/smoke-test.sh'
        }
    }

    protectedStage('Post-build cleanup') {
        dir('swiftacular') {
            sh './kube_deploy/scripts/teardown-cluster.sh'
        }
    }
}
